{
	"manifest_version": 3,
	"name": "__MSG_extName__",
	"version": "2.4.1",
	"description": "__MSG_extDescription__",
	"default_locale": "en",
	"permissions": ["activeTab", "downloads", "offscreen", "scripting", "storage", "unlimitedStorage"],
	"host_permissions": ["https://arena.ai/*", "https://*.arena.ai/*"],
	"background": {
		"service_worker": "background.js"
	},
	"action": {
		"default_title": "__MSG_extName__",
		"default_popup": "popup.html"
	},
	"options_page": "options.html",
	"content_scripts": [
		{
			"matches": ["https://arena.ai/*", "https://*.arena.ai/*"],
			"js": ["scrollbars.js", "early.js"],
			"run_at": "document_start"
		},
		{
			"matches": ["https://arena.ai/*", "https://*.arena.ai/*"],
			"js": ["shared.js", "pageBridge.js"],
			"run_at": "document_start",
			"world": "MAIN"
		},
		{
			"matches": ["https://arena.ai/*", "https://*.arena.ai/*"],
			"js": ["i18n.js", "shared.js", "codebase.js", "perf.js", "scrollbars.js", "chatTemplates.js", "content.js", "perfWrap.js"],
			"run_at": "document_idle"
		}
	],
	"icons": {
		"16": "icons/16.png",
		"48": "icons/48.png",
		"128": "icons/128.png"
	}
}
