{
	"manifest_version": 3,
	"name": "Arena Utils",
	"version": "2.0.0",
	"description": "Export arena.ai chats, insert prompts, disable autoscroll, jump between messages and other...",
	"permissions": ["activeTab", "downloads", "storage", "unlimitedStorage"],
	"host_permissions": ["https://arena.ai/*", "https://*.arena.ai/*"],
	"background": {
		"service_worker": "background.js"
	},
	"action": {
		"default_title": "Arena Utils",
		"default_popup": "popup.html"
	},
	"options_page": "options.html",
	"content_scripts": [
		{
			"matches": ["https://arena.ai/*", "https://*.arena.ai/*"],
			"js": ["early.js"],
			"run_at": "document_start"
		},
		{
			"matches": ["https://arena.ai/*", "https://*.arena.ai/*"],
			"js": ["pageBridge.js"],
			"run_at": "document_start",
			"world": "MAIN"
		},
		{
			"matches": ["https://arena.ai/*", "https://*.arena.ai/*"],
			"js": ["content.js"],
			"run_at": "document_idle"
		}
	],
	"icons": {
		"16": "icons/16.png",
		"48": "icons/48.png",
		"128": "icons/128.png"
	}
}
